{
  "name": "tusharkhan/db-error-explainer-laravel",
  "description": "Laravel integration for DB Error Explainer - Ignition panels, service providers, and artisan commands",
  "keywords": [
    "laravel",
    "database",
    "error",
    "ignition",
    "debugging",
    "mysql"
  ],
  "homepage": "https://github.com/tusharkhan/db-error-explainer-laravel",
  "license": "MIT",
  "authors": [
    {
      "name": "Tushar Khan",
      "email": "tushar.khan0122@gmail.com"
    }
  ],
  "type": "library",
  "support": {
    "issues": "https://github.com/tusharkhan/db-error-explainer-laravel/issues",
    "source": "https://github.com/tusharkhan/db-error-explainer-laravel"
  },
  "require": {
    "php": "^8.4",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "tusharkhan/db-error-explainer-core": "^1.0|@dev",
    "tusharkhan/db-error-explainer-lib": "^1.0|@dev"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.0",
    "spatie/laravel-ignition": "^2.9"
  },
  "suggest": {
    "spatie/laravel-ignition": "Shows the explanation and fix as a solution on the Ignition error page"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../lib",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "TusharKhan\\DbErrorExplainer\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TusharKhan\\DbErrorExplainer\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TusharKhan\\DbErrorExplainer\\Laravel\\ExplainerServiceProvider"
      ],
      "aliases": {
        "DbExplainer": "TusharKhan\\DbErrorExplainer\\Laravel\\Facades\\DbExplainer"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
